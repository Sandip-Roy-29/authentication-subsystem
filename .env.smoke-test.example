NODE_ENV=test
PORT=8000

MONGODB_URI=mongodb://auth-mongo:27017/crosslink-test

REDIS_HOST=crosslink-redis
REDIS_PORT=6379

ACCESS_TOKEN_SECRET=thirty-two-character-long-test-secret
REFRESH_TOKEN_SECRET=thirty-two-character-long-test-refresh-secret

BCRYPT_SALT_ROUNDS=1

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

DB_MIN_POOL_SIZE=10
DB_MAX_POOL_SIZE=20

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=10

REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=60

ADMIN_RATE_LIMIT_WINDOW_MS=3600000
ADMIN_RATE_LIMIT_MAX=100

VERIFICATION_RATE_LIMIT_WINDOW_MS=600000
VERIFICATION_RATE_LIMIT_MAX=10

RESEND_VERIFICATION_RATE_LIMIT_WINDOW_MS=3600000
RESEND_VERIFICATION_RATE_LIMIT_MAX=5

FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=600000
RESET_PASSWORD_RATE_LIMIT_MAX=10

GOOGLE_RATE_LIMIT_WINDOW_MS=3600000
GOOGLE_RATE_LIMIT_MAX=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=test@gmail.com
SMTP_PASSWORD=dummy-password

GOOGLE_CLIENT_ID=test-client
GOOGLE_CLIENT_SECRET=test-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:5173