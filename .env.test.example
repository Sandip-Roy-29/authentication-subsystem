NODE_ENV=test
PORT=5000

MONGODB_URI=mongodb://localhost:27017/auth-test

DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=5

BCRYPT_SALT_ROUNDS=1

ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_EXPIRY=7d

REDIS_HOST=localhost
REDIS_PORT=6379

LOGIN_RATE_LIMIT_WINDOW_MS=1000
LOGIN_RATE_LIMIT_MAX=2

REGISTER_RATE_LIMIT_WINDOW_MS=1000
REGISTER_RATE_LIMIT_MAX=2

REFRESH_RATE_LIMIT_WINDOW_MS=1000
REFRESH_RATE_LIMIT_MAX=2

ADMIN_RATE_LIMIT_WINDOW_MS=3600000
ADMIN_RATE_LIMIT_MAX=100

VERIFICATION_RATE_LIMIT_WINDOW_MS=600000
VERIFICATION_RATE_LIMIT_MAX=10

RESEND_VERIFICATION_RATE_LIMIT_WINDOW_MS=3600000
RESEND_VERIFICATION_RATE_LIMIT_MAX=5

FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=600000
RESET_PASSWORD_RATE_LIMIT_MAX=10

GOOGLE_RATE_LIMIT_WINDOW_MS=3600000
GOOGLE_RATE_LIMIT_MAX=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=test@gmail.com

GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:5173